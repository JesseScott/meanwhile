<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Meanwhile</string>

    <!-- What the app is, in one line. Shown under the app name on the main screen and on the location intro. -->
    <string name="tagline">News from the other side of the world</string>

    <!-- Progress: one line next to a spinner, saying what a load is doing right now. -->
    <string name="progress_loading">Loading…</string>
    <string name="progress_locating">Getting your location…</string>
    <string name="progress_finding_land">Looking for land on the other side of the world…</string>
    <!-- %1$s is a country name. -->
    <string name="progress_fetching_headlines">Fetching headlines from %1$s… this can take up to a minute the first time.</string>
    <!-- Shown while loading sea conditions (waves, water temperature) for a spot in the open ocean. -->
    <string name="progress_reading_sea">Reading the sea…</string>
    <!-- %1$s is the country that was just tried. -->
    <string name="progress_trying_next">%1$s had no headlines, trying the next closest country…</string>
    <string name="progress_checking_more">Checking for more headlines…</string>

    <!-- Errors: a load failed and there is nothing to show. "Antipode" is the point on the exact opposite side of the Earth. -->
    <string name="error_location_off">Location is turned off on your phone. Turn it on, or search for a place.</string>
    <string name="error_location_unavailable">Couldn\'t get your location. Try again, or search for a place.</string>
    <string name="error_no_land_nearby">Couldn\'t find any land near your antipode. Try another place.</string>
    <string name="error_no_headlines">No headlines found near your antipode. Try another place.</string>
    <!-- The news services are overloaded or refusing requests for the moment. -->
    <string name="error_busy">Headlines are busy right now. Try again in a minute.</string>
    <string name="error_offline">You seem to be offline. Check your connection and try again.</string>
    <string name="error_unknown">Something went wrong. Try again.</string>
    <string name="error_try_again">Try again</string>
    <!-- Button that opens the phone's own location settings. -->
    <string name="error_location_settings">Location settings</string>

    <!-- Notices: something worth saying that doesn't replace what is on screen. -->
    <!-- %1$s is what the user typed into the search bar. -->
    <string name="notice_no_places">No places found for \"%1$s\".</string>
    <!-- The search couldn't be made at all, usually because there is no connection. -->
    <string name="notice_search_failed">Couldn\'t search right now. Check your connection and try again.</string>
    <string name="notice_location_denied">Location is off for Meanwhile. Search for a place, or turn it on in your phone\'s settings.</string>
    <!-- A refresh failed, so the headlines loaded earlier stay on screen. -->
    <string name="notice_refresh_failed">Couldn\'t refresh. Showing what we had.</string>
    <!-- Button that opens this app's page in the phone's settings. -->
    <string name="open_settings">Open settings</string>

    <!-- The Location row on the About screen: its detail line, and the button that turns location on. -->
    <string name="location_access_on">On. Meanwhile can use your approximate location.</string>
    <string name="location_access_can_ask">Off. Meanwhile will ask Android for your approximate location.</string>
    <string name="location_access_blocked">Off. Android has stopped asking, so turn it on under Permissions in the app\'s settings.</string>
    <!-- Button: turn on location access. -->
    <string name="location_access_turn_on">Turn on</string>

    <!-- Headings over groups of headlines, by how recent they are. -->
    <string name="recency_today">Today</string>
    <string name="recency_yesterday">Yesterday</string>
    <string name="recency_earlier">Earlier this week</string>

    <!-- Main screen: shown before any place has been chosen. -->
    <string name="main_hint">Allow location, or search for a place, to see what\'s happening on the other side of the world.</string>
    <!-- Nothing was published there in the last day, so the list goes back a week. -->
    <string name="main_quiet_today">Quiet there today, so this shows the last week.</string>
    <!-- %1$s is a country name. -->
    <string name="main_no_headlines_for_country">No headlines found for %1$s.</string>
    <string name="main_no_headlines_for_region">No headlines found for that region.</string>
    <!-- A small badge on a headline that comes from a news outlet in or about that place, not a worldwide wire. -->
