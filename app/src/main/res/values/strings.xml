    <!-- Location intro: shown once, before Android's own location prompt. -->
    <string name="intro_what_it_does">It shows what\'s happening on the opposite side of the Earth from where you are.</string>
    <string name="intro_location_title">Your approximate location</string>
    <!-- A privacy promise: keep "only" and "approximate" exact. -->
    <string name="intro_location_body">Next, Android will ask to share your approximate location. Meanwhile only uses it to work out the point exactly opposite you.</string>
    <string name="intro_ocean_title">Mostly ocean</string>
    <string name="intro_ocean_body">For most people that point is open water. You\'ll see the sea first, with a prompt to read headlines from the nearest land.</string>
    <string name="intro_keep_title">What we keep</string>
    <!-- A privacy promise: the location is not stored, and reports are off by default. "About" is the name of the About screen. -->
    <string name="intro_keep_body">Meanwhile doesn\'t store your location, and there\'s no account. Usage and crash reports are off unless you turn them on in Settings (the info button at the top), where you can also read the details.</string>
    <string name="intro_continue">Continue</string>
    <string name="intro_search_instead">Search for a place instead</string>

