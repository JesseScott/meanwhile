    <string name="search_placeholder">Search for a place</string>
    <!-- Accessibility label for the button that empties the search bar. -->
    <string name="search_clear">Clear</string>
    <!-- Accessibility label for the button that uses the phone's location. -->
    <string name="search_use_my_location">Use my location</string>
    <string name="recent_places_title">Recent places</string>
