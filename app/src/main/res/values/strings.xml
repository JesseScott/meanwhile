    <string name="ocean_sun_twilight">Twilight. The sun is just %1$d° below the horizon.</string>
    <string name="ocean_sun_night">Night. The sun is %1$d° below the horizon.</string>
    <string name="ocean_no_sea_data">No sea data for this spot right now.</string>
