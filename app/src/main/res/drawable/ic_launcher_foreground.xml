<?xml version="1.0" encoding="utf-8"?>
<!-- Direction A: a globe with one line from you to the opposite point. Drawn inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Globe outline -->
    <path
        android:pathData="M28,54 a26,26 0 1,0 52,0 a26,26 0 1,0 -52,0"
        android:strokeColor="#EAF0FF"
        android:strokeWidth="3" />

    <!-- Meridian -->
    <path
        android:pathData="M44,54 a10,26 0 1,0 20,0 a10,26 0 1,0 -20,0"
        android:strokeColor="#EAF0FF"
        android:strokeAlpha="0.55"
        android:strokeWidth="2" />

    <!-- The line through the Earth -->
    <path
        android:pathData="M35.6,35.6 L72.4,72.4"
        android:strokeColor="#FFB703"
        android:strokeLineCap="round"
        android:strokeWidth="3.5" />

    <!-- You -->
    <path
        android:fillColor="#EAF0FF"
        android:pathData="M30.1,35.6 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0" />

    <!-- Them -->
    <path
        android:fillColor="#FFB703"
        android:pathData="M66.9,72.4 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0" />
</vector>
